{
 "align_labels_right": 0,
 "creation": "2026-08-02 00:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Trip Statement",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n.print-format { font-size: 10px; color: #111827; }\n.tetax-title { background: #263447; color: #fff; text-align: center; font-weight: 700; padding: 5px; border: 1px solid #111827; }\n.tetax-subtitle { background: #344256; color: #fff; text-align: center; font-weight: 700; padding: 4px; border: 1px solid #111827; }\n.tetax-table { width: 100%; border-collapse: collapse; margin: 0; }\n.tetax-table th, .tetax-table td { border: 1px solid #4b5563; padding: 4px 5px; vertical-align: middle; }\n.tetax-table th { background: #2f3d50; color: #fff; text-align: center; font-weight: 700; }\n.tetax-table .label-cell { background: #2f3d50; color: #fff; font-weight: 700; width: 14%; }\n.tetax-table .value-cell { background: #e8edf3; }\n.tetax-table .number { text-align: right; }\n.tetax-summary { background: #dbe8ce; font-weight: 700; }\n.tetax-balance { background: #263447; color: #fff; }\n</style>\n<div class=\"tetax-title\">{{ doc.company or \"TETAX LIMITED\" }}</div>\n<div class=\"tetax-subtitle\">Billing Statement</div>\n<table class=\"tetax-table\">\n <tr>\n  <td class=\"label-cell\">Bill to</td>\n  <td class=\"value-cell\" colspan=\"3\">{{ doc.customer or \"\" }}</td>\n  <td class=\"label-cell\">Statement Date</td>\n  <td class=\"value-cell\">{{ doc.get_formatted(\"posting_date\") }}</td>\n </tr>\n <tr>\n  <td class=\"label-cell\">Truck</td>\n  <td class=\"value-cell\">{{ doc.truck or \"\" }}</td>\n  <td class=\"label-cell\">Driver</td>\n  <td class=\"value-cell\">{{ doc.driver or \"\" }}</td>\n  <td class=\"label-cell\">Statement #</td>\n  <td class=\"value-cell\">{{ doc.name }}</td>\n </tr>\n <tr>\n  <td class=\"label-cell\">Route</td>\n  <td class=\"value-cell\" colspan=\"3\">{{ doc.route or \"\" }}</td>\n  <td class=\"label-cell\">Sales Invoice</td>\n  <td class=\"value-cell\">{{ doc.sales_invoice or \"\" }}</td>\n </tr>\n</table>\n<div class=\"tetax-subtitle\">Account Activity</div>\n<table class=\"tetax-table\">\n <thead>\n  <tr>\n   <th style=\"width: 10%;\">Date</th>\n   <th style=\"width: 12%;\">Invoice #</th>\n   <th style=\"width: 12%;\">Truck</th>\n   <th style=\"width: 14%;\">Driver</th>\n   <th>Description</th>\n   <th style=\"width: 8%;\">Qty</th>\n   <th style=\"width: 10%;\">Rate</th>\n   <th style=\"width: 12%;\">Payment</th>\n   <th style=\"width: 12%;\">Invoice Amount</th>\n   <th style=\"width: 12%;\">Balance</th>\n  </tr>\n </thead>\n <tbody>\n  {% set ns = namespace(balance=0) %}\n  {% for row in doc.revenue_items %}\n   {% set ns.balance = ns.balance + row.amount %}\n   <tr>\n    <td>{{ doc.get_formatted(\"trip_date\") }}</td>\n    <td>{{ doc.sales_invoice or \"\" }}</td>\n    <td>{{ doc.truck or \"\" }}</td>\n    <td>{{ doc.driver or \"\" }}</td>\n    <td>{{ row.description }}</td>\n    <td class=\"number\">{{ row.qty }}</td>\n    <td class=\"number\">{{ row.get_formatted(\"rate\", doc) }}</td>\n    <td class=\"number\"></td>\n    <td class=\"number\">{{ row.get_formatted(\"amount\", doc) }}</td>\n    <td class=\"number tetax-balance\">{{ frappe.utils.fmt_money(ns.balance, currency=doc.currency) }}</td>\n   </tr>\n  {% endfor %}\n  {% for row in doc.expense_items %}\n   {% set ns.balance = ns.balance - row.amount %}\n   <tr>\n    <td>{{ doc.get_formatted(\"trip_date\") }}</td>\n    <td>{{ row.purchase_invoice or \"\" }}</td>\n    <td>{{ doc.truck or \"\" }}</td>\n    <td>{{ doc.driver or \"\" }}</td>\n    <td>{{ row.description }}</td>\n    <td class=\"number\">{{ row.qty }}</td>\n    <td class=\"number\">{{ row.get_formatted(\"rate\", doc) }}</td>\n    <td class=\"number\">{{ row.get_formatted(\"amount\", doc) }}</td>\n    <td class=\"number\"></td>\n    <td class=\"number tetax-balance\">{{ frappe.utils.fmt_money(ns.balance, currency=doc.currency) }}</td>\n   </tr>\n  {% endfor %}\n  <tr class=\"tetax-summary\">\n   <td colspan=\"7\" class=\"number\">Totals</td>\n   <td class=\"number\">{{ doc.get_formatted(\"total_expenses\") }}</td>\n   <td class=\"number\">{{ doc.get_formatted(\"total_revenue\") }}</td>\n   <td class=\"number\">{{ doc.get_formatted(\"gross_profit\") }}</td>\n  </tr>\n  <tr class=\"tetax-summary\">\n   <td colspan=\"9\" class=\"number\">Profit Margin</td>\n   <td class=\"number\">{{ doc.get_formatted(\"profit_margin\") }}</td>\n  </tr>\n </tbody>\n</table>",
 "idx": 0,
 "line_breaks": 0,
